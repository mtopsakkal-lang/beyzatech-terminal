{
  "expo": {
    "name": "BEYZATECH TERMINAL",
    "slug": "beyzatech-terminal",
    "version": "11.0.0",

    "orientation": "portrait",

    "icon": "./assets/icon.png",

    "userInterfaceStyle": "dark",

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#090D16"
    },

    "android": {

      "package": "com.beyzatech.terminal",

      "versionCode": 11,

      "permissions": [
        "INTERNET",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],

      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#090D16"
      }
    },

    "plugins": [
      "expo-notifications"
    ]
  }
}
